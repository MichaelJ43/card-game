{
  "name": "card-game",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "gen:ai-catalog": "node scripts/gen-ai-heuristic-catalog.mjs",
    "build": "npm run gen:ai-catalog && tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest",
    "test:ci": "vitest run",
    "build:e2e": "VITE_MULTIPLAYER_HTTP_URL=https://e2e.example.com VITE_MULTIPLAYER_WS_URL=wss://e2e.example.com npm run build",
    "test:live": "playwright test",
    "test:live:ci": "playwright test",
    "gen:sounds": "node scripts/generate-tone-wavs.mjs"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "@vitejs/plugin-react": "^6.0.5",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.9.0",
    "ts-morph": "^28.0.0",
    "typescript": "~6.0.2",
    "@playwright/test": "^1.62.1",
    "typescript-eslint": "^8.66.0",
    "vite": "^8.2.1",
    "vitest": "^5.0.0"
  },
  "overrides": {
    "@babel/core": "7.29.6",
    "brace-expansion": "5.0.8",
    "js-yaml": "4.3.0"
  }
